{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "types": ["@playwright/test", "node"]
  },
  "include": ["**/*.js"],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
