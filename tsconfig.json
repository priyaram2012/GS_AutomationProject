{
    "compilerOptions": {
        "target": "es2016",
        "lib": [
            "es2016",
            "dom"
        ],
        "module": "commonjs",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "node_modules"
    ]
}